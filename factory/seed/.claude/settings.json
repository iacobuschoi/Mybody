{
  "permissions": {
    "deny": [
      "Read(*.p8)",
      "Read(*.p12)",
      "Read(*.jks)",
      "Read(*.keystore)",
      "Read(*.mobileprovision)",
      "Read(key.properties)",
      "Read(KEY-INFO.txt)",
      "Read(*service-account*.json)",
      "Read(.env)",
      "Read(.env.*)",
      "Edit(.github/CODEOWNERS)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
